              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/5/results": {
      "get": {
        "tags": [
          "Forecasting"
        ],
        "summary": "Results",
        "operationId": "results_api_v1_tasks_5_results_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResults"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/5/forecast": {
      "get": {
        "tags": [
          "Forecasting"
        ],
        "summary": "Forecast",
        "operationId": "forecast_api_v1_tasks_5_forecast_get",
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "releases",
                "additions"
              ],
              "type": "string",
              "default": "releases",
              "title": "Target"
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "movies",
                "tv"
              ],
              "type": "string",
              "default": "all",
              "title": "Group"
            }
          },
          {
            "name": "horizon",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 6,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Horizon"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
